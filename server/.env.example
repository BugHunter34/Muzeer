NODE_ENV=production
PORT=3000
TRUST_PROXY=1

CORS_ALLOWED_ORIGINS=https://app.example.com,https://your-project.pages.dev
MEDIA_CORS_ALLOWED_ORIGINS=https://app.example.com,https://your-project.pages.dev

PUBLIC_API_URL=https://api.example.com
COOKIE_DOMAIN=api.example.com
COOKIE_SAME_SITE=none

MEDIA_PORT=5000

DATABASE=mongodb+srv://YOUR_CLUSTER_URI
DATABASE_DIRECT=mongodb://DIRECT_FALLBACK_URI
JWT_SECRET=replace-with-a-long-random-secret

# Google OAuth (get from console.cloud.google.com -> APIs -> Credentials -> OAuth 2.0 Client IDs)
# Authorized redirect URI must be: https://api.yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/api/auth/google/callback

# Where to redirect browser after successful OAuth (your frontend domain)
FRONTEND_URL=https://muzeer.com